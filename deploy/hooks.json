[
  {
    "id": "deploy",
    "execute-command": "/opt/estatesmart/app/deploy/deploy.sh",
    "command-working-directory": "/opt/estatesmart/app",
    "response-message": "Đã nhận yêu cầu deploy",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "{{ getenv "WEBHOOK_SECRET" | js }}",
            "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "refs/heads/main",
            "parameter": { "source": "payload", "name": "ref" }
          }
        }
      ]
    }
  }
]
