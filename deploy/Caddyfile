# Caddy tự xin và gia hạn chứng chỉ HTTPS (Let's Encrypt) cho tên miền.
{$DOMAIN} {
	encode zstd gzip

	# GitHub Webhook → dịch vụ webhook chạy trên máy chủ (cổng 9000)
	handle /hooks/* {
		reverse_proxy host.docker.internal:9000
	}

	# API trợ lý AI; flush_interval -1 để chữ được đẩy tới trình duyệt ngay khi mô hình sinh ra
	handle /api/* {
		reverse_proxy api:8787 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:80
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
