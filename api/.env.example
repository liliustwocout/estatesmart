# Sao chép thành api/.env khi chạy trên máy. Trên VPS, đặt các biến này trong /opt/estatesmart/api.env (quyền 600).
DEEPSEEK_API_KEY=
# Mật khẩu trang /quan-tri/ (tối thiểu 12 ký tự; để trống thì trang quản trị tắt)
ADMIN_PASSWORD=
# Nơi lưu cơ sở dữ liệu (mặc định api/data/local.db; trong Docker là /data/estatesmart.db)
# DB_PATH=
# Tuỳ chọn: đổi nhà cung cấp tương thích chuẩn OpenAI
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=
# Giới hạn sử dụng (xem docs/HUONG_DAN_CICD.md mục 14.2)
# MAX_CONCURRENT_PER_IP=1
# RATE_MIN_INTERVAL_MS=3000
# RATE_LIMIT_MAX=15
# RATE_LIMIT_WINDOW_MS=600000
# IP_DAILY_LIMIT=60
# DUPLICATE_WINDOW_MS=120000
# MAX_CONCURRENT=10
# DAILY_LIMIT=1000
# DAILY_TOKEN_LIMIT=2000000
